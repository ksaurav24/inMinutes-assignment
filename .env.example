POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

API_PORT=8080
WEB_PORT=3000

# Used by the API when running outside Docker (pnpm dev:api)
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
# Used by the web app to reach the API
NEXT_PUBLIC_API_URL=http://localhost:8080
